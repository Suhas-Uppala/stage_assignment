# Environment Configuration Template for OTT Dialect Platform
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# 1. APPLICATION & SERVER SETTINGS
# ==============================================================================
APP_ENV=development
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
LOG_LEVEL=INFO

# ==============================================================================
# 2. STORAGE & REPOSITORY PATHS
# ==============================================================================
DATA_DIR=data
CATALOGUE_DIR=data/catalogue
SYNTHETIC_PACK_DIR=data/synthetic_pack
SAMPLE_RUN_DIR=sample_run
DATABASE_PATH=sample_run/agent_state.db

# ==============================================================================
# 3. OPERATIONAL BUDGETS & LATENCY CONSTRAINTS (Assignment SLA)
# ==============================================================================
# Decision target: SLA < 60 seconds per decision
LATENCY_BUDGET_SECONDS=60.0
# Hard failure threshold: > 5 minutes is classified as system failure
MAX_LATENCY_FAILURE_SECONDS=300.0
# Offline buffered event age threshold (Surprise Scenario 1)
MAX_EVENT_AGE_SECONDS=300.0
# Per-decision model call budget
MAX_MODEL_CALLS_PER_DECISION=8
# Per-decision tool call budget
MAX_TOOL_CALLS_PER_DECISION=20

# ==============================================================================
# 4. POLICY & USER SAFETY CONSTRAINTS
# ==============================================================================
# Quiet hours window in viewer's local time (22:00 to 08:00)
QUIET_HOURS_START=22
QUIET_HOURS_END=8
# Daily message frequency cap per viewer
MAX_MESSAGES_PER_VIEWER_PER_DAY=1
# Minimum titles required to publish HOME_PAGE carousel
MIN_HOME_PAGE_TITLES=3

# ==============================================================================
# 5. LLM PROVIDER & API KEYS (Optional for Production)
# ==============================================================================
# When True, uses the self-contained deterministic mock provider (zero external keys needed).
# Set to False to connect a live commercial LLM provider.
USE_MOCK_LLM=true
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=5.0
LLM_MAX_RETRIES=2

# Live Commercial LLM API Keys (Keep empty if USE_MOCK_LLM=true)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
